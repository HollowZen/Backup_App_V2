<Window x:Class="BackupApp.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:BackupApp.WPF.Controls"
        xmlns:converters="clr-namespace:BackupApp.WPF.Converters"
        xmlns:behaviors="clr-namespace:BackupApp.WPF.Behaviors"
        mc:Ignorable="d"
        Title="Менеджер резервного копирования"
        WindowState="Maximized"
        MinWidth="1024"
        MinHeight="768"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ScheduleTypeToStringConverter x:Key="ScheduleTypeToStringConverter" />
        <converters:BackupTypeToStringConverter x:Key="BackupTypeToStringConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#00BCD4"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Менеджер резервного копирования"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Запустить планировщик"
                            Command="{Binding StartSchedulerCommand}"
                            Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Foreground="White"
                            Background="#4CAF50" />
                    <Button Content="Остановить планировщик"
                            Command="{Binding StopSchedulerCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Foreground="White"
                            Background="#F44336" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            
            <!-- Tab 1: Главная (Список задач) -->
            <TabItem Header="Главная">
                <Grid Margin="10">
            <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="400" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Tasks List -->
            <Border Grid.Column="0"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                                    Background="#00BCD4"
                                    Padding="16,12"
                            CornerRadius="4,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                        <TextBlock Text="Задачи резервного копирования"
                                   Foreground="White"
                                   FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Content="Создать задачу"
                                                Command="{Binding AddTaskCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Foreground="White"
                                                Background="#00ACC1"
                                                Padding="12,6"
                                                Margin="0,0,8,0" />
                                        <Button Content="Запустить"
                                                Command="{Binding RunTaskCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Foreground="White"
                                                Background="#00ACC1"
                                                Padding="12,6"
                                                Margin="0,0,8,0" />
                                        <Button Content="Удалить"
                                                Command="{Binding DeleteTaskCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Foreground="White"
                                                Background="#00ACC1"
                                                Padding="12,6"
                                                Margin="0,0,8,0" />
                                    </StackPanel>
                                </Grid>
                    </Border>

                            <ListView Grid.Row="1"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4"
                                                            Padding="0">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E0F7FA" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#B2EBF2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Padding="16"
                                                             Margin="0"
                                                             materialDesign:ElevationAssist.Elevation="Dp2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Header Row -->
                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="0"
                                                            Orientation="Horizontal"
                                                            Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Foreground="#00ACC1"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0" />
                                                    <Border Background="#9E9E9E"
                                                            CornerRadius="12"
                                                            Padding="8,4"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                        <TextBlock Text="Отключена"
                                                                   FontSize="11"
                                                                   Foreground="White" />
                                                    </Border>
                                                    <Border Background="#4CAF50"
                                                            CornerRadius="12"
                                                            Padding="8,4"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Активна"
                                                                   FontSize="11"
                                                                   Foreground="White" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Info Grid -->
                                                <Grid Grid.Row="1"
                                                      Grid.Column="0"
                                                      Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Source Path -->
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="0"
                                                               Text="Источник:"
                                                               FontWeight="SemiBold"
                                                               Foreground="Gray"
                                                               Margin="0,0,8,4" />
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="1"
                                                               Text="{Binding SourcePath}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               Foreground="Black"
                                                               ToolTip="{Binding SourcePath}"
                                                               Margin="0,0,16,4" />

                                                    <!-- Target Path -->
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="0"
                                                               Text="Назначение:"
                                                               FontWeight="SemiBold"
                                                               Foreground="Gray"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="1"
                                                               Text="{Binding TargetPath}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               Foreground="Black"
                                                               ToolTip="{Binding TargetPath}"
                                                               Margin="0,0,16,0" />

                                                    <!-- Backup Type -->
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="2"
                                                               Text="Тип:"
                                                               FontWeight="SemiBold"
                                                               Foreground="Gray"
                                                               Margin="0,0,8,4" />
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="3"
                                                               Text="{Binding BackupType, Converter={StaticResource BackupTypeToStringConverter}}"
                                                               Foreground="Black"
                                                               Margin="0,0,0,4" />

                                                    <!-- Schedule -->
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="2"
                                                               Text="Расписание:"
                                                               FontWeight="SemiBold"
                                                               Foreground="Gray"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="3"
                                                               Text="{Binding ScheduleType, Converter={StaticResource ScheduleTypeToStringConverter}}"
                                                               Foreground="Black" />
                                                </Grid>

                                                <!-- Footer Row -->
                                                <StackPanel Grid.Row="2"
                                                            Grid.Column="0"
                                                            Orientation="Horizontal">
                                                    <TextBlock Text="Последний запуск:"
                                                               FontWeight="SemiBold"
                                                               Foreground="Gray"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding LastBackupTime, StringFormat={}{0:dd.MM.yyyy HH:mm}, TargetNullValue='Никогда'}"
                                                               Foreground="Black" />
                                                </StackPanel>
                                            </Grid>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Progress Section -->
                    <Border Grid.Row="2"
                            Background="#F5F7FB"
                            Padding="16"
                           BorderBrush="LightGray"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,4,4">
                        <StackPanel>
                            <TextBlock Text="Процесс резервного копирования"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                      Margin="0,0,0,8" />
                            <ProgressBar Height="16"
                                         Margin="0,0,0,8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding BackupProgress, Mode=OneWay}"
                                                 Visibility="{Binding IsBackupInProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding IsBackupInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentTransferFile}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Скорость:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TransferSpeedText}"
                                                       Foreground="Gray"
                                                       Margin="6,0,12,0" />
                                            <TextBlock Text="Осталось:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RemainingTimeText}"
                                                       Foreground="Gray"
                                                       Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                                    <ProgressBar Height="4"
                                                 Margin="0,0,0,12"
                                                 IsIndeterminate="True">
                                <ProgressBar.Style>
<Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsBusy}" Value="True" />
                                                    <Condition Binding="{Binding IsBackupInProgress}" Value="False" />
</MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Foreground="Gray" />
                            <TextBlock Text="Лог выполнения"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <Border BorderBrush="LightGray"
BorderThickness="1"
                                    CornerRadius="6"
                                            Background="White"
                                            MaxHeight="200">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding ExecutionLog}"
                                         BorderThickness="0"
                                                     Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="Gray"
                                                                   Margin="4,2" />
</DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                        </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

                    <!-- Details Panel -->
            <Border Grid.Column="2"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Детали задачи"
                               FontSize="18"
                               FontWeight="SemiBold"
                                           Margin="0,0,0,12"
                                           TextWrapping="Wrap" />

                    <TextBlock Text="{Binding SelectedTask.Name, TargetNullValue='Задача не выбрана'}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,8" />

                                <Separator Margin="0,0,0,12" />

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Источник" 
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedTask.SourcePath, TargetNullValue='—'}"
                                   TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                   Foreground="Gray"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Назначение" 
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedTask.TargetPath, TargetNullValue='—'}"
                                   TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                   Foreground="Gray"
                                  Margin="0,2,0,0" />
                    </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Расписание" 
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedTask.ScheduleType, Converter={StaticResource ScheduleTypeToStringConverter}}"
                                               TextWrapping="Wrap"
                                   Foreground="Gray"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SelectedTask.ScheduleTime, StringFormat='Время: {0}', TargetNullValue='Время не задано'}"
                                               TextWrapping="Wrap"
                                   Foreground="Gray" />
                    </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Параметры копирования" 
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedTask.BackupType, Converter={StaticResource BackupTypeToStringConverter}, StringFormat='Тип: {0}', TargetNullValue='—'}"
                                               TextWrapping="Wrap"
                                   Foreground="Gray"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SelectedTask.UseCompression, StringFormat='ZIP: {0}', TargetNullValue='—'}"
                                               TextWrapping="Wrap"
                                   Foreground="Gray" />
                    </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Создание/Редактирование задачи -->
            <TabItem Header="Задача">
                <Grid Margin="10">
                    <materialDesign:Card Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="#00BCD4"
                                    Padding="20,14">
                                <TextBlock Text="{Binding TaskTabHeader}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>

                            <!-- Content -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="20">
                                <TabControl>
                                    <TabItem Header="Основные">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="Имя задачи" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding CurrentTaskViewModel.Name, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Введите имя задачи" />

                                            <TextBlock Text="Путь источника"
                                                       Margin="0,16,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding CurrentTaskViewModel.SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,8,0"
                                                         TextWrapping="NoWrap"
                                                         materialDesign:HintAssist.Hint="Выберите папку источника" />
                                                <Button Grid.Column="1"
                                                        Content="..."
                                                        Width="32"
                                                        Command="{Binding CurrentTaskViewModel.BrowseSourcePathCommand}" />
                                            </Grid>

                                            <TextBlock Text="Путь назначения"
                                                       Margin="0,16,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding CurrentTaskViewModel.TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,8,0"
                                                         TextWrapping="NoWrap"
                                                         AcceptsReturn="False"
                                                         materialDesign:HintAssist.Hint="Выберите папку назначения" />
                                                <Button Grid.Column="1"
                                                        Content="..."
                                                        Width="32"
                                                        Command="{Binding CurrentTaskViewModel.BrowseTargetPathCommand}" />
                                            </Grid>

                                            <CheckBox Content="Задача включена"
                                                      Margin="0,16,0,0"
                                                      IsChecked="{Binding CurrentTaskViewModel.IsEnabled}" />
                                        </StackPanel>
                                    </TabItem>

                                    <TabItem Header="Расписание">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="Тип расписания" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding CurrentTaskViewModel.ScheduleTypes}"
                                                      SelectedItem="{Binding CurrentTaskViewModel.ScheduleType}"
                                                      materialDesign:HintAssist.Hint="Выберите тип расписания" />

                                            <StackPanel>
                                                <TextBlock Text="Время запуска" Margin="0,16,0,4" />
                                                <controls:TimePickerControl SelectedTime="{Binding CurrentTaskViewModel.ScheduleTimeValue, Mode=TwoWay}"
                                                                            MinuteStep="5"
                                                                            Margin="0,4,0,0" />
                                            </StackPanel>

                                            <StackPanel>
                                                <TextBlock Text="Дни недели" Margin="0,16,0,4" />
                                                <ItemsControl ItemsSource="{Binding CurrentTaskViewModel.WeeklyDayOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding DisplayName}"
                                                                      Margin="0,0,12,8"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel>
                                                <TextBlock Text="День месяца" Margin="0,16,0,4" />
                                                <ComboBox ItemsSource="{Binding CurrentTaskViewModel.MonthDayOptions}"
                                                          SelectedItem="{Binding CurrentTaskViewModel.ScheduleDayOfMonth, UpdateSourceTrigger=PropertyChanged}"
                                                          materialDesign:HintAssist.Hint="Выберите день месяца"
                                                          MinWidth="140" />
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>

                                    <TabItem Header="Параметры копирования">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="Тип бэкапа" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding CurrentTaskViewModel.BackupTypes}"
                                                      SelectedItem="{Binding CurrentTaskViewModel.BackupType}"
                                                      materialDesign:HintAssist.Hint="Выберите тип резервной копии"
                                                      MinWidth="200" />

                                            <Separator Margin="0,16,0,16" />

                                            <CheckBox Content="Использовать сжатие (ZIP)"
                                                      IsChecked="{Binding CurrentTaskViewModel.UseCompression}" />

                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="Уровень сжатия (0-9)" Margin="0,0,0,4" />
                                                <Slider Minimum="0"
                                                        Maximum="9"
                                                        TickFrequency="1"
                                                        IsSnapToTickEnabled="True"
                                                        IsEnabled="{Binding CurrentTaskViewModel.UseCompression}"
                                                        Value="{Binding CurrentTaskViewModel.CompressionLevel, Mode=TwoWay}" />
                                                <TextBlock Text="{Binding CurrentTaskViewModel.CompressionLevel, StringFormat='Текущий уровень: {0}'}"
                                                           Foreground="Gray"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>

                                    <TabItem Header="Шифрование">
                                        <StackPanel Margin="8">
                                            <CheckBox Content="Использовать шифрование AES"
                                                      IsChecked="{Binding CurrentTaskViewModel.UseEncryption}" />

                    <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="Пароль шифрования (минимум 8 символов)" Margin="0,0,0,4" />
                                                <PasswordBox Name="EncryptionPasswordBox"
                                                             IsEnabled="{Binding CurrentTaskViewModel.UseEncryption}"
                                                             materialDesign:HintAssist.Hint="Введите пароль шифрования"
                                                             behaviors:PasswordBoxBindingBehavior.Password="{Binding CurrentTaskViewModel.EncryptionPassword, Mode=TwoWay}" />
                                                <TextBlock Text="Пароль будет безопасно сохранен с использованием DPAPI"
                                                           FontSize="11"
                                   Foreground="Gray"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding CurrentTaskViewModel.UseEncryption, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>

                                    <TabItem Header="Хранение">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="Политика хранения" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding CurrentTaskViewModel.RetentionPolicyTypes}"
                                                      SelectedItem="{Binding CurrentTaskViewModel.RetentionPolicyType}"
                                                      materialDesign:HintAssist.Hint="Выберите политику хранения"
                                                      MinWidth="200" />

                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="Максимальное количество версий" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding CurrentTaskViewModel.MaxVersions, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="100"
                                                         HorizontalAlignment="Left"
                                                         materialDesign:HintAssist.Hint="Количество версий" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="Максимальный возраст в днях" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding CurrentTaskViewModel.MaxAgeDays, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="100"
                                                         HorizontalAlignment="Left"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="False"
                                                         materialDesign:HintAssist.Hint="Количество дней" />
                    </StackPanel>

                                            <TextBlock Text="Старые версии бэкапов будут автоматически удаляться"
                                                       FontSize="11"
                                                       Foreground="Gray"
                                                       Margin="0,12,0,0" />
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </ScrollViewer>

                            <!-- Footer -->
                            <Border Grid.Row="2"
                                    Background="#EEF2F7"
                                    Padding="16,12">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CurrentTaskViewModel.ValidationError}"
                                               Foreground="Red"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0" />
                                    <Button Content="ОТМЕНА"
                                            Width="110"
                                            Margin="0,0,8,0"
                                            Command="{Binding CancelTaskCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                    <Button Content="СОХРАНИТЬ"
                                            Width="140"
                                            Padding="12,4"
                                            Command="{Binding SaveTaskCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- Tab 3: Расшифровка -->
            <TabItem Header="Расшифровка">
                <Grid Margin="10">
                    <materialDesign:Card Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="#00BCD4"
                                    Padding="20,14">
                                <TextBlock Text="Расшифровка резервной копии"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>

                            <!-- Content -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="20">
                                <StackPanel MaxWidth="800"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Выберите зашифрованный файл:"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding CurrentDecryptViewModel.EncryptedFilePath, Mode=OneWay, FallbackValue=''}"
                                                 IsReadOnly="True"
                                                 Height="35"
                                                 VerticalContentAlignment="Center"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="False"
                                                 materialDesign:HintAssist.Hint="Путь к зашифрованному файлу" />
                                        <Button Grid.Column="1"
                                                Content="Обзор..."
                                                Width="100"
                                                Height="35"
                                                Margin="10,0,0,0"
                                                Command="{Binding CurrentDecryptViewModel.BrowseEncryptedFileCommand, FallbackValue={x:Null}}"
                                                Style="{StaticResource MaterialDesignRaisedButton}" />
                                    </Grid>

                                    <TextBlock Text="Выберите папку для расшифрованных файлов:"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding CurrentDecryptViewModel.OutputDirectory, Mode=OneWay, FallbackValue=''}"
                                                 IsReadOnly="True"
                                                 Height="35"
                                                 VerticalContentAlignment="Center"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="False"
                                                 materialDesign:HintAssist.Hint="Папка для расшифрованных файлов" />
                                        <Button Grid.Column="1"
                                                Content="Обзор..."
                                                Width="100"
                                                Height="35"
                                                Margin="10,0,0,0"
                                                Command="{Binding CurrentDecryptViewModel.BrowseOutputDirectoryCommand, FallbackValue={x:Null}}"
                                                Style="{StaticResource MaterialDesignRaisedButton}" />
                                    </Grid>

                                    <TextBlock Text="Введите пароль для расшифровки:"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />

                                    <PasswordBox x:Name="DecryptPasswordBox"
                                                 Height="40"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="14"
                                                 Padding="8"
                                                 Margin="0,0,0,20"
                                                 PasswordChar="*"
                                                 materialDesign:HintAssist.Hint="Пароль шифрования"
                                                 ToolTip="Введите пароль, который использовался при шифровании резервной копии"
                                                 behaviors:PasswordBoxBindingBehavior.Password="{Binding CurrentDecryptViewModel.Password, Mode=TwoWay}" />

                                    <ProgressBar Height="20"
                                                 Margin="0,0,0,10"
                                                 Visibility="{Binding CurrentDecryptViewModel.IsDecrypting, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                 IsIndeterminate="True" />

                                    <TextBlock Text="{Binding CurrentDecryptViewModel.StatusMessage, FallbackValue=''}"
                                               TextWrapping="Wrap"
                                               Foreground="Gray"
                                               Margin="0,0,0,20" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Footer -->
                            <Border Grid.Row="2"
                                    Background="#EEF2F7"
                                    Padding="16,12">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                       <Button Content="Расшифровать"
                                            Width="150"
                                            Height="40"
                                            Command="{Binding CurrentDecryptViewModel.DecryptCommand, FallbackValue={x:Null}}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
        <StatusBarItem>
            <TextBlock Text="{Binding StatusMessage}" />
        </StatusBarItem>
        <Separator />
        <StatusBarItem HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Текущая задача:" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedTask.Name, TargetNullValue='Задача не выбрана'}"
                           Foreground="Gray"
                           Margin="6,0,0,0" />
            </StackPanel>
        </StatusBarItem>
        <Separator />
        <StatusBarItem HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Планировщик:" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SchedulerStatus}"
                           Foreground="Gray"
                           Margin="6,0,0,0" />
            </StackPanel>
        </StatusBarItem>
        <Separator />
        <StatusBarItem HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Таймер:" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PrecisionTimerStatus}"
                           Foreground="Gray"
                           Margin="6,0,0,0" />
            </StackPanel>
        </StatusBarItem>
    </StatusBar>
        </Grid>
</Window>
