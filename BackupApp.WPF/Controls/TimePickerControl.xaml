<UserControl x:Class="BackupApp.WPF.Controls.TimePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinWidth="160"
             d:DesignHeight="64"
             d:DesignWidth="200">
    <UserControl.Resources>
    </UserControl.Resources>

    <Border BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8"
            Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <RepeatButton
                              Content="▲"
                              Delay="200"
                              Interval="70"
                              Click="OnHourUpClick" />
                <TextBlock
                           Text="{Binding SelectedTime, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:hh}, TargetNullValue=--}" />
                <RepeatButton
                              Content="▼"
                              Delay="200"
                              Interval="70"
                              Click="OnHourDownClick" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text=":"
                       VerticalAlignment="Center"
                       Margin="12,0"
                       FontSize="20"
                       FontWeight="Bold" />

            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <RepeatButton
                              Content="▲"
                              Delay="200"
                              Interval="70"
                              Click="OnMinuteUpClick" />
                <TextBlock
                           Text="{Binding SelectedTime, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:mm}, TargetNullValue=--}" />
                <RepeatButton
                              Content="▼"
                              Delay="200"
                              Interval="70"
                              Click="OnMinuteDownClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>






